"""
SO100 Leader Arm Module

The leader arm is used in teleoperation to control a follower arm.
It has torque disabled so the operator can move it freely.
"""

from solarian.core.module import Module


class SO100LeaderArmModule(Module):
    """
    SO100 robot arm module configured as a leader (human-controlled arm).
    
    In teleoperation setups, the leader arm is moved by a human operator,
    and its joint positions are read and sent to a follower arm.
    
    Key differences from follower:
        - Torque is disabled (arm can be moved freely)
        - Position readings are the primary output
    """
    
    def initialize(self):
        """Initialize the arm with torque disabled for manual control."""
        super().initialize()

        # Disable torque so operator can move the arm freely
        self.disable_actuators_torque()
        
        # Still configure communication settings
        self.write_actuators("Return_Delay_Time", 0)
        
        # Position control mode (even though torque is off, 
        # this affects how positions are read/reported)
        self.set_actuators_position_mode()

