[project]
name = "${dist_name}"
version = "0.1.0"
description = "A Solarian plugin."
authors = [
    {name = "Solarian Contributors", email = "solarian@example.com"}
]
readme = "README.md"
requires-python = ">=3.10"
dependencies = [
    "solarian>=0.1.0",
    # Add plugin-specific dependencies here (e.g. a hardware SDK).
]

[build-system]
requires = ["setuptools>=61.0"]
build-backend = "setuptools.build_meta"

# Build only the plugin package. This disables setuptools flat-layout
# auto-discovery, which otherwise fails when the plugin root also contains
# non-package directories such as `assets/`, `tests/`, or `docs/`.
[tool.setuptools.packages.find]
include = ["${package_name}*"]

# `solarian install` copies templates/<folder>/<name>.yaml to conf/<folder>/<name>.yaml.
[tool.setuptools.package-data]
${package_name} = ["templates/*/*.yaml"]

# Entry points below are managed by `solarian create-plugin`. Each component
# type you scaffold adds its class(es) here so Solarian can discover them.
