# Default configuration for the ${class_prefix}Module.
#
# Copied into a project's conf/ directory by `solarian add-module`.
# Edit the values below to match your hardware setup.

# Serial port / device address the module's bus connects to. Point it at
# conf/deployment/<name>.yaml (`port: ${deployment.actuator_port_<module>}`) if
# it differs between the machines you run this robot on.
port: /dev/ttyUSB0

# Control loop frequency (Hz).
fps: 30

# Per-component configuration keyed by the class-attribute names declared on
# the module (e.g. actuator ids/models). Example:
#
# actuators:
#   shoulder:
#     id: 1
#     model: sts3215
#     mode: range_m100_100
