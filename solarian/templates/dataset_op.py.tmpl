"""``${op_name}``: a dataset op of this project.

Every ``<package>/datasets/<file>.py`` is an op, named after its file (``_``
becomes ``-``) unless the class sets ``name``; there is nothing to register.
Run it from the project:

    solarian dataset ops                                  # lists it, as project:...
    solarian dataset apply data/cups ${op_name} --param min_frames=60

This one is a FILTER: it keeps or drops whole episodes. A MAP op implements
``map(episode, params, ctx)`` instead and returns ``episode.derive(files, **meta)``
with the members it adds or replaces; see solarian.datasets.op for every kind.
To reuse the op across projects, move this file into a plugin and add one entry
point under ``solarian.dataset_ops`` (``solarian create-plugin op <name>``).
"""

from __future__ import annotations

from pydantic import BaseModel, Field

from solarian.datasets import DatasetOp, Episode, OpKind


class ${class_name}Params(BaseModel):
    min_frames: int = Field(default=30, ge=1, description="Episodes with fewer rows are dropped.")


class ${class_name}Op(DatasetOp):
    title = "${op_title}"
    description = """
    Drop the episodes shorter than min_frames: false starts and aborted demos.
    """
    kind = OpKind.FILTER
    Params = ${class_name}Params

    def keep(self, episode: Episode, params: ${class_name}Params) -> bool:
        return episode.n_rows >= params.min_frames
