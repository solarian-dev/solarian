# One LeRobot ACT training run. Copy this file per run.
#
#   solarian train --conf conf/training/lerobot_act
#
# Selects the installed trainer (solarian.trainers entry point).
trainer: lerobot_act

train_dataset: null
val_dataset: null
val_percentage: 0.2
job_name: ${project_name}_train
resume: false
batch_size: 16
steps: 100000
log_freq: 100
save_freq: 10000
num_workers: 4
wandb:
    enable: false
    project: ${project_name}
    disable_artifact: true
model:
    n_obs_steps: 1
    chunk_size: 100
    n_action_steps: 100
    use_vae: true
    temporal_ensemble_coeff: null
