defaults:
  # conf/controller.yaml, merged at the top level.
  - /controller@_global_
  - _self_
# Only the shape of the session lives here. Which sides record is the
# `recording:` block in controller.yaml; how the robot stores its episodes is
# the `recording:` block in robot.yaml.
name: ${project_name}
num_episodes: 3
# null records until the operator presses r or delete.
episode_time_s: 30.0
reset_time_s: 5
reset_period: 1
play_sounds: true
# One episode per task, cycled. Empty records the controller's own `task`.
tasks: []
