from solarian.core import DataComputer, Data, Observation, ModuleObs, SensorObs, DataKind
import numpy as np


class JointObs(SensorObs):
    pos = Data(computer=DataComputer.ROBOT, dtype=int)
    speed = Data(computer=DataComputer.ROBOT, dtype=int)

class ImageObs(SensorObs):
    image = Data(shape=(224, 224, 3), computer=DataComputer.ROBOT, dtype=np.uint8, kind=DataKind.IMAGE)

class ArmObs(ModuleObs):
    shoulder_pan = JointObs()
    shoulder_lift = JointObs()
    elbow_flex = JointObs()
    wrist_flex = JointObs()
    wrist_yaw = JointObs()
    wrist_roll = JointObs()


class GripperObs(ModuleObs):
    width = JointObs()


class WristCamObs(ModuleObs):
    image = ImageObs()


class MySolarianObservation(Observation):
    arm = ArmObs()
    gripper = GripperObs()
    wrist_cam = WristCamObs()
